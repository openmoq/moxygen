StreamReadHandle::stopSending unregistered the QUIC read callback but left a
pending readStreamData() promise open. The peer's solicited RESET_STREAM then
had no callback to arrive on, so the read did not complete until session
teardown. Fail the pending read, as WtStreamManager's ReadHandle does.

diff --git a/proxygen/lib/http/webtransport/WebTransportImpl.h b/proxygen/lib/http/webtransport/WebTransportImpl.h
index 3f0746a1b..4eb50c2c7 100644
--- a/proxygen/lib/http/webtransport/WebTransportImpl.h
+++ b/proxygen/lib/http/webtransport/WebTransportImpl.h
@@ -318,7 +318,11 @@ class WebTransportImpl
 
     folly::Expected<folly::Unit, WebTransport::ErrorCode> stopSending(
         uint32_t error) override {
-      return impl_.stopReadingWebTransportIngress(id_, error);
+      auto res = impl_.stopReadingWebTransportIngress(id_, error);
+      // The read callback is gone, so the solicited RESET_STREAM cannot fail
+      // a pending read. May destroy this handle.
+      deliverReadError(WebTransport::Exception(error, "sent stop_sending"));
+      return res;
     }
 
     FCState dataAvailable(std::unique_ptr<folly::IOBuf> data, bool eof);
